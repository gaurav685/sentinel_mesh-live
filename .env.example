# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# "development" (default) or "production". Enables validate_production_config's
# startup warnings for unsafe defaults left in place (app/config.py).
# SML_ENVIRONMENT=development

# Python logging level: DEBUG, INFO (default), WARNING, ERROR.
# SML_LOG_LEVEL=INFO

# Comma-separated allowed CORS origins, or "*" (default). Restrict to the
# deployed frontend's real origin(s) in production, e.g.
# SML_CORS_ORIGINS=https://sentinelmesh-live.example.com
# SML_CORS_ORIGINS=*

# Postgres (AuraDB-compatible connection string works here too). Omit to
# use the sqlite+aiosqlite default (fine for local dev/demo).
# SML_DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# Local disk path for the embedded Chroma client.
# SML_CHROMA_PERSIST_DIR=./data/chroma

# Redis Streams connection (app/bus/redis_streams.py, replay/main.py).
# SML_REDIS_URL=redis://localhost:6379

# LLM for app/chat/query.py, OpenAI-compatible /chat/completions wire
# format -- works with OpenAI, Groq, Together, a local Ollama/vLLM
# openai-compat server, etc. by changing these three values.
SML_LLM_API_KEY=
SML_LLM_API_BASE=https://api.openai.com/v1
SML_LLM_MODEL=gpt-4o-mini
# SML_LLM_TIMEOUT_S=30
# SML_LLM_MAX_TOKENS=1024

# Phase 7 hardening: max request body size, and per-IP requests/minute
# against LLM-calling routes (/api/chat, chain report generation).
# SML_MAX_REQUEST_BODY_BYTES=1000000
# SML_LLM_RATE_LIMIT_PER_MINUTE=20
